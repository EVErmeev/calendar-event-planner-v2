# Environment
APP_ENV=development
DRY_RUN=true
DEFAULT_TIMEZONE=Asia/Yekaterinburg
DEFAULT_DURATION_SUGGESTION=60
MEETING_DATE_POLICY=AGREED_ONLY
CALENDAR_MATCH_TOLERANCE_MINUTES=30
CALENDAR_SUBJECT_THRESHOLD=0.75
CONTACT_FUZZY_THRESHOLD=0.85
RUNS_DIR=./runs
MAX_FILE_SIZE_MB=50

# MCP Settings
MCP_ENABLED=true
MCP_SERVER_URL=
MCP_CALENDAR_FIND_TOOL=list_events
MCP_CALENDAR_CREATE_TOOL=create_event
MCP_DIRECTORY_SEARCH_TOOL=search_employees

# Google API
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Exchange
EXCHANGE_ENABLED=false